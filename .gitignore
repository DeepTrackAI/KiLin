# macOS metadata
.DS_Store

# Local Python environment
.venv/

# Local sandbox contents
/sandbox/*
!sandbox/.gitkeep

# Python-generated files
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test, type-checker, and formatter caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
htmlcov/

# Jupyter temporary files
.ipynb_checkpoints/

# Local secrets; a documented example may still be committed
.env
.env.*
!.env.example

# Local model caches and model weights
.genrag/
models/
weights/
*.safetensors
*.gguf
*.bin
*.onnx
*.pt
*.pth
*.ckpt
*.incomplete

# QAChat generated project workspaces -- "code" kind defaults to
# repository/, "literature" kind defaults to documents/ (source = ...
# in each project's profile.ini decides which one a given sandbox uses).
# Location-agnostic (like the indexes/logs rules below) so this covers
# both sandbox/ (your own QAChat projects) and benchmarks/sandbox/
# (benchmark project scaffolding).
**/repository/*
!**/repository/.gitkeep
**/documents/*
!**/documents/.gitkeep

# qachat/ + tutorials/ staging copy (rebuilt fresh every run) and the workspace
# it produces.
benchmarks/sandbox/_staging/
benchmarks/sandbox/project_qachat_and_tutorials*/qachat_and_tutorials/

# project_DeepTrack2 similarly points source at a local DeepTrack2 checkout's
# repo root, not the repository/ default. Folder name matches the checkout's own name (case-sensitive).
benchmarks/sandbox/project_DeepTrack2*/DeepTrack2/

# Runtime output
**/indexes/*
!**/indexes/.gitkeep
**/logs/*
!**/logs/.gitkeep
*.log
*.ini
!profile.ini

# QAChat's own saved sync manifest (prepare_project_workspace) -- generated
# sandbox state used for delta-sync between runs, same category as
# indexes/ and logs/ above.
**/source_snapshot.json

# Benchmark run outputs (regenerated by the benchmark notebooks)
benchmarks/results/*
!benchmarks/results/.gitkeep